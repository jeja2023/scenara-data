{
  "$id": "https://contracts.scenara.dev/repository/1.2.0/domain-annotation-schema.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$",
      "title": "Domain",
      "type": "string"
    },
    "payload_schema": {
      "additionalProperties": true,
      "title": "Payload Schema",
      "type": "object"
    },
    "quality_rules": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Quality Rules",
      "type": "array"
    },
    "schema_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,255}$",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_media_kinds": {
      "items": {
        "enum": [
          "image",
          "video",
          "document",
          "stream"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Media Kinds",
      "type": "array"
    },
    "task_type": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Task Type",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "version",
    "domain",
    "task_type",
    "supported_media_kinds",
    "payload_schema"
  ],
  "title": "DomainAnnotationSchema",
  "type": "object"
}
