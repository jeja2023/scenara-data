# Must match scenara/deploy/shared-infra/.env.example.
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_DATA_DB_PASSWORD=replace-with-data-db-password
SCENARA_INFRA_REDIS_PASSWORD=replace-with-redis-password
SCENARA_DATA_S3_ACCESS_KEY=scenara-data
SCENARA_DATA_S3_SECRET_KEY=replace-with-data-s3-secret

# Core -> Data bearer token. Model's token is also included in the allowlist.
SCENARA_DATA_SERVICE_TOKEN=replace-with-core-to-data-token
SCENARA_DATA_TRUSTED_SERVICE_TOKENS=replace-with-core-to-data-token,replace-with-model-to-data-token
SCENARA_DATA_CONTEXT_SIGNING_KEY=replace-with-shared-data-context-key

# Data -> Core event token; must match Core SCENARA_DATA_EVENT_SERVICE_TOKEN.
SCENARA_DATA_CORE_EVENT_TOKEN=replace-with-data-to-core-event-token
