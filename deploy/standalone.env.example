# scenara data 独立管理模式。
# Data 仍使用共享 PostgreSQL、Redis、MinIO 和 scenara-platform 网络，
# 但不依赖 Core 的身份上下文和事件接收端点。
SCENARA_DATA_IMAGE=scenara-data:<git-commit-sha>
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_PLATFORM_CERTS_DIR=/secure/scenara-certs
SCENARA_PLATFORM_CA_FILE=/run/tls/ca.crt
SCENARA_DATA_HTTP_PORT=8081

SCENARA_DATA_DATABASE_URL=postgresql://scenara_data:<password>@postgres.scenara.internal:5432/scenara_data?sslmode=verify-full&sslrootcert=/run/tls/ca.crt
SCENARA_DATA_REDIS_URL=rediss://:<password>@redis.scenara.internal:6379/1?ssl_cert_reqs=required&ssl_ca_certs=/run/tls/ca.crt
SCENARA_DATA_S3_ENDPOINT_URL=https://minio.scenara.internal:9000
SCENARA_DATA_S3_REGION=us-east-1
SCENARA_DATA_CORS_ALLOW_ORIGINS=https://data.scenara.internal:8081
