# 不要在此文件写入密钥；*_FILE 值由 compose.production.yml 的 external secrets 提供。
# Standard production may use a registry digest. The current single-host
# deployment uses the full Git commit SHA tag built locally on Ubuntu.
SCENARA_DATA_IMAGE=scenara-data:replace-with-git-commit-sha
SCENARA_PLATFORM_NETWORK=scenara-platform
SCENARA_PLATFORM_CERTS_DIR=/secure/scenara-certs
SCENARA_PLATFORM_CA_FILE=/run/tls/ca.crt
SCENARA_DATA_REDIS_URL=rediss://:replace-with-redis-password@redis.scenara.internal:6379/1?ssl_cert_reqs=required&ssl_ca_certs=/run/tls/ca.crt
SCENARA_DATA_S3_ENDPOINT_URL=https://minio.scenara.internal:9000
SCENARA_DATA_S3_REGION=region-1
SCENARA_DATA_CORE_EVENT_ENDPOINT=https://core.scenara.internal:8000/internal/v1/data/events
SCENARA_DATA_CORS_ALLOW_ORIGINS=https://core.scenara.internal:8000,https://data.scenara.internal:8081
# 启用内置 Data 工作台时，使用 external secrets: data_console_password 与
# data_console_session_secret；两者均须与服务间凭据不同。
SCENARA_DATA_CONSOLE_LOGIN_ENABLED=true
SCENARA_DATA_SERVE_FRONTEND=true
SCENARA_DATA_HTTP_PORT=8081
SCENARA_PLATFORM_CERTS_DIR=/secure/scenara-certs
SCENARA_PLATFORM_CA_FILE=/run/tls/ca.crt
# data_database_url secret 示例：postgresql://scenara_data:password@postgres.scenara.internal:5432/scenara_data?sslmode=verify-full&sslrootcert=/run/tls/ca.crt
