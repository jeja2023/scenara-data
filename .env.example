# ==============================================================================
# 景枢数据管理平台（Scenara Data）环境变量配置文件 (.env / .env.example)
# ==============================================================================
# 使用指南：
# 1. 本配置文件定义了数据管理服务的核心运行时参数、外部存储/中间件连接以及安全策略。
# 2. 新环境部署时，请复制 .env.example 为 .env 并按实际运行环境配置各变量：
#    cp .env.example .env
# 3. 生产环境中，敏感凭据（如数据库密码、S3密钥、服务令牌等）支持通过 *_FILE 变量
#    从挂载的文件中读取（例如配合 Docker Secrets 或 Kubernetes Secrets 使用）。
#    注意：明文变量与对应的 *_FILE 变量为互斥关系，切勿同时设置。
# 4. 当 SCENARA_DATA_DEPLOYMENT_PROFILE=production 时，系统会自动开启严格的安全基准，
#    要求全链路使用 TLS/HTTPS、各密钥长度不少于 32 位、强制启用签名上下文等。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 运行模式与部署环境画像 (Runtime & Deployment Profile)
# ------------------------------------------------------------------------------

# 部署环境画像（控制安全约束强度与校验行为）：
# - development: 本地开发与集成联调模式，允许非 TLS 明文连接与宽松安全规则。
# - production: 生产部署模式，强制启用 TLS 传输加密、凭证最小长度校验 (>= 32 字符) 与短时身份签名。
SCENARA_DATA_DEPLOYMENT_PROFILE=development

# 数据管理平台运行时存储事实模式：
# - postgres: 关系型数据库持久化事实模式，连接外部真实 PostgreSQL、Redis 与 S3 对象存储（生产环境及本地联调必用）。
# - memory: 纯内存数据源模式，仅供开发阶段快速单测或离线功能验证使用。
SCENARA_DATA_RUNTIME_MODE=postgres

# 规范 63/72 定义的成熟度阶梯声明（可选，系统默认 implemented）：
# 可选值：planned, seed, implemented, qualified, production_ready。
# 本仓库未完成目标生产环境物理资格验证前，最高只允许声明 implemented。
# SCENARA_DATA_MATURITY=implemented


# ------------------------------------------------------------------------------
# 2. 关系型数据库配置 (PostgreSQL Database)
# ------------------------------------------------------------------------------

# PostgreSQL 关系型数据库连接 URI。
# 承载数据集元数据、样本清单、版本演进快照、事务发件箱 (Outbox) 与操作审计。
# 格式：postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名称]
# 生产环境约束：必须配置真实数据库连接，且必须包含 TLS 参数（如 ?sslmode=verify-full 或 ?sslmode=require）。
# 支持通过 SCENARA_DATA_DATABASE_URL_FILE 指定密钥文件路径。
SCENARA_DATA_DATABASE_URL=postgresql://scenara_data:change-me@127.0.0.1:5432/scenara_data


# ------------------------------------------------------------------------------
# 3. 缓存与分布式锁 (Redis)
# ------------------------------------------------------------------------------

# Redis 实例连接 URI。
# 用于跨实例分布式锁、任务防重排队与健康探针锁状态校验。
# 格式：redis://[用户名]:[密码]@[主机]:[端口]/[数据库编号]
# 生产环境约束：必须使用 TLS 加密协议（rediss://...）。
SCENARA_DATA_REDIS_URL=redis://127.0.0.1:6379/1


# ------------------------------------------------------------------------------
# 4. 对象存储服务配置 (S3 / MinIO Object Storage)
# ------------------------------------------------------------------------------

# S3 兼容对象存储服务端点 URL。
# 本地开发环境通常为 MinIO 端点 (如 http://127.0.0.1:9000)，生产环境必须使用 HTTPS 端点 (https://...)。
SCENARA_DATA_S3_ENDPOINT_URL=http://127.0.0.1:9000

# 对象存储所在的物理/逻辑区域标识（Region），默认 us-east-1。
SCENARA_DATA_S3_REGION=us-east-1

# 对象存储访问密钥 ID (Access Key ID)。
# 支持通过 SCENARA_DATA_S3_ACCESS_KEY_ID_FILE 指定密钥文件路径。
SCENARA_DATA_S3_ACCESS_KEY_ID=change-me

# 对象存储私有密钥 (Secret Access Key)。
# 支持通过 SCENARA_DATA_S3_SECRET_ACCESS_KEY_FILE 指定密钥文件路径。
SCENARA_DATA_S3_SECRET_ACCESS_KEY=change-me

# 是否强制要求对象存储桶开启多版本控制 (Versioning)。
# 开发环境默认为 false；生产环境 (production) 下系统会自动强制为 true。
# SCENARA_DATA_REQUIRE_OBJECT_VERSIONING=false


# ------------------------------------------------------------------------------
# 5. 对象存储桶划分 (Object Storage Buckets)
# ------------------------------------------------------------------------------

# 数据集主存储桶：存放原始媒体、切片、标注附件与清洗后样本数据。
SCENARA_DATA_DATASET_BUCKET=scenara-datasets

# 数据清单存储桶：存放版本快照元数据清单 (Manifest JSON / Parquet) 文件。
SCENARA_DATA_MANIFEST_BUCKET=scenara-data-manifests

# 批量导入暂存桶：承接来自外部源端导入的大文件与异构数据包。
SCENARA_DATA_IMPORT_BUCKET=scenara-data-imports

# 数据导出存储桶：存放供模型训练或外发使用的数据集打包导出文件。
SCENARA_DATA_EXPORT_BUCKET=scenara-data-exports

# 衍生工件存储桶：存放数据质量探针评测结果、分析图表与评估产物。
SCENARA_DATA_ARTIFACT_BUCKET=scenara-artifacts

# 数据平台备份存储桶：存放数据库物理/逻辑转储快照及全量对象清单冷备份。
SCENARA_DATA_BACKUP_BUCKET=scenara-data-backups


# ------------------------------------------------------------------------------
# 6. 安全认证与身份信任 (Security & Identity Context)
# ------------------------------------------------------------------------------

# 平台内部微服务间通信信任凭证 (Bearer Token)。
# 用于平台内微服务调用数据服务 API 时的鉴权。
# 安全约束：
# - postgres 运行模式下必须配置，禁止使用内置开发弱口令 (如 scenara-data-dev-token)；
# - production 生产环境下长度必须至少 32 位字符。
# 支持通过 SCENARA_DATA_TRUSTED_SERVICE_TOKEN_FILE 指定密钥文件路径。
SCENARA_DATA_TRUSTED_SERVICE_TOKEN=change-me

# 请求身份上下文 HMAC-SHA256 签名密钥。
# 用于校验平台透传头 (X-Scenara-Context-*) 中租户、项目、主体、权限范围的真实性与防伪造。
# 安全约束：
# - production 生产环境下必须显式配置且长度至少 32 位字符；
# - 严禁与 SCENARA_DATA_TRUSTED_SERVICE_TOKEN 配置相同的值。
# 支持通过 SCENARA_DATA_REQUEST_CONTEXT_SIGNING_KEY_FILE 指定密钥文件路径。
SCENARA_DATA_REQUEST_CONTEXT_SIGNING_KEY=change-me-development-only

# 是否强制要求外部请求携带有效的签名上下文。
# 开发环境默认为 false；生产环境 (production) 下系统会自动强制为 true。
# SCENARA_DATA_REQUIRE_SIGNED_REQUEST_CONTEXT=false

# 签名请求上下文的时间戳允许最大偏差/有效期（秒），防重放攻击，默认 300 秒（5分钟）。
# SCENARA_DATA_REQUEST_CONTEXT_MAX_AGE_SECONDS=300

# 临时数据访问授权 (Access Grant) 的最长有效生存时间（秒），默认 86400 秒（24小时）。
# SCENARA_DATA_ACCESS_GRANT_MAX_TTL_SECONDS=86400


# ------------------------------------------------------------------------------
# 7. 核心平台集成与发件箱服务 (Core Events & Outbox)
# ------------------------------------------------------------------------------

# 核心平台 (Core) 内部领域事件接收端点 URL。
# 数据平台产生的重要业务事件（如版本发布、难例入库、变更通知）由 Outbox 进程异步投递至此。
# 约束：postgres 运行模式下必填；生产环境下必须使用 HTTPS 协议。
SCENARA_DATA_CORE_EVENT_ENDPOINT=http://127.0.0.1:18080/internal/v1/data/events

# 投递领域事件给核心平台时使用的内部服务凭证。
# 约束：配置 Core 事件端点时必填；生产环境下长度必须至少 32 位字符。
# 支持通过 SCENARA_DATA_CORE_EVENT_TOKEN_FILE 指定密钥文件路径。
SCENARA_DATA_CORE_EVENT_TOKEN=change-me

# 投递事件时的 HTTP 请求超时时间（秒），默认 5.0 秒。
# SCENARA_DATA_CORE_EVENT_TIMEOUT_SECONDS=5

# 发件箱后台轮询工作进程每次批量提取并投递的事件数量，默认 100。
# SCENARA_DATA_OUTBOX_BATCH_SIZE=100

# 发件箱事件投递失败最大重试次数，超限进入死信排查状态，默认 8。
# SCENARA_DATA_OUTBOX_MAX_ATTEMPTS=8

# 允许向数据服务触发数据变更操作的源系统白名单（逗号分隔），默认 scenara,scenara-core。
# SCENARA_DATA_ALLOWED_SOURCE_SYSTEMS=scenara,scenara-core


# ------------------------------------------------------------------------------
# 8. 数据工作台本地管理配置 (Data Console - Local Management)
# ------------------------------------------------------------------------------

# 是否启用内置前端工作台本地用户名/密码登录接口 (/login)。
# - development: 开发环境默认为 true，便于本地启动独立前端工作台联调；
# - production: 生产环境建议设为 false，生产访问必须通过核心平台统一网关与统一身份认证 (SSO) 接入。
SCENARA_DATA_CONSOLE_LOGIN_ENABLED=true

# 本地工作台默认管理员登录用户名，默认为 admin。
SCENARA_DATA_CONSOLE_USERNAME=admin

# 本地工作台默认管理员登录密码。
# 若未设置或留空，系统启动时将默认自动复用 SCENARA_DATA_TRUSTED_SERVICE_TOKEN 的值。
# 支持通过 SCENARA_DATA_CONSOLE_PASSWORD_FILE 指定密钥文件路径。
SCENARA_DATA_CONSOLE_PASSWORD=change-me

# 本地工作台登录会话 Token 签名密钥。
# 若未设置，系统默认复用 SCENARA_DATA_TRUSTED_SERVICE_TOKEN 的值。
# 支持通过 SCENARA_DATA_CONSOLE_SESSION_SECRET_FILE 指定密钥文件路径。
# SCENARA_DATA_CONSOLE_SESSION_SECRET=change-me

# 工作台登录会话有效期（秒），默认 86400 秒（24小时）。
# SCENARA_DATA_CONSOLE_SESSION_TTL_SECONDS=86400

# 工作台登录防暴力破解尝试次数上限，连续失败超限将触发限流锁定，默认 5 次。
# SCENARA_DATA_CONSOLE_LOGIN_MAX_ATTEMPTS=5

# 工作台登录防暴力破解限流统计窗口时长（秒），默认 300 秒（5分钟）。
# SCENARA_DATA_CONSOLE_LOGIN_WINDOW_SECONDS=300

# 本地工作台会话默认绑定的租户标识，默认为 default。
SCENARA_DATA_CONSOLE_TENANT_ID=default

# 本地工作台会话默认绑定的项目标识，默认为 default。
SCENARA_DATA_CONSOLE_PROJECT_ID=default

# 本地工作台会话预置的权限范围（逗号分隔，默认提供所有 data.* 操作权限）。
# SCENARA_DATA_CONSOLE_SCOPES=data.dataset.create,data.dataset.read,data.dataset.update,data.dataset.publish,data.dataset.archive,data.sample.create,data.sample.read,data.annotation.create,data.annotation.review,data.quality.run,data.lineage.read,data.import.execute,data.export.execute,data.hard_sample.import

# 本地工作台会话预置的产品权益标识（逗号分隔），默认 scenara.data。
# SCENARA_DATA_CONSOLE_ENTITLEMENTS=scenara.data


# ------------------------------------------------------------------------------
# 9. 跨域资源共享配置 (CORS - Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------

# 允许跨域请求的前端 Origin 来源白名单（逗号分隔）。
# 默认为本地 Vite 开发服务及预览端口：5173 与 4173。
# 生产环境约束：严禁使用通配符 *，必须显式指定 HTTPS 协议的受信任正式域名。
SCENARA_DATA_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
