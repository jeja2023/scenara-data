SCENARA_DATA_RUNTIME_MODE=postgres
SCENARA_DATA_DATABASE_URL=postgresql://scenara_data:change-me@127.0.0.1:5432/scenara_data
SCENARA_DATA_REDIS_URL=redis://127.0.0.1:6379/1
SCENARA_DATA_S3_ENDPOINT_URL=http://127.0.0.1:9000
SCENARA_DATA_S3_REGION=us-east-1
SCENARA_DATA_S3_ACCESS_KEY_ID=change-me
SCENARA_DATA_S3_SECRET_ACCESS_KEY=change-me
SCENARA_DATA_DATASET_BUCKET=scenara-datasets
SCENARA_DATA_MANIFEST_BUCKET=scenara-data-manifests
SCENARA_DATA_IMPORT_BUCKET=scenara-data-imports
SCENARA_DATA_EXPORT_BUCKET=scenara-data-exports
SCENARA_DATA_TRUSTED_SERVICE_TOKEN=change-me
SCENARA_DATA_CONSOLE_USERNAME=admin
# 若不设置，数据工作台登录密码默认复用 SCENARA_DATA_TRUSTED_SERVICE_TOKEN。
SCENARA_DATA_CONSOLE_PASSWORD=change-me
SCENARA_DATA_CONSOLE_TENANT_ID=default
SCENARA_DATA_CONSOLE_PROJECT_ID=default
SCENARA_DATA_ARTIFACT_BUCKET=scenara-artifacts
